-
-    viewModelScope.launch {
-      val profileKey = RegistrationPreferences.profileKey
-      val unidentifiedAccessKey = profileKey?.let { deriveUnidentifiedAccessKey(it) }
-      val aep = RegistrationPreferences.aep
