-      currentState.originalFile.delete()
-    }
-    selectedVideo = null
-    _transcodingState.value = TranscodingState.Idle
-  }
-
-  companion object {
-    private const val MEGABIT = 1_000_000
-    private const val KILOBIT = 1_000
