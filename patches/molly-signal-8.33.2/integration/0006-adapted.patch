-      ShakeToReportEvent.SubmitClicked -> {
-        if (_state.value.step == Step.Prompt) {
-          submit()
-        }
-      }
-      ShakeToReportEvent.RetryClicked -> {
-        if (_state.value.step == Step.Failed) {
