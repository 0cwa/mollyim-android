diff --git a/app/src/main/java/org/thoughtcrime/securesms/backup/v2/LegacyBackupNotification.kt b/app/src/main/java/org/thoughtcrime/securesms/backup/v2/LegacyBackupNotification.kt
new file mode 100644
index 00000000..33acf38c
--- /dev/null
+++ b/app/src/main/java/org/thoughtcrime/securesms/backup/v2/LegacyBackupNotification.kt
@@ -0,0 +1,13 @@
+package org.thoughtcrime.securesms.backup.v2
+
+/**
+ * Molly's previous thread-ID range could overlap the old backup alert IDs. Match both the ID and the stable alerts channel so upgrade cleanup does not
+ * remove an unrelated conversation notification.
+ */
+internal fun isLegacyBackupNotification(
+  notificationId: Int,
+  tag: String?,
+  channelId: String?,
+  legacyId: Int,
+  backupAlertsChannel: String
+): Boolean = notificationId == legacyId && tag == null && channelId == backupAlertsChannel
