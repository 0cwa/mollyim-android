-  private static @Nullable String getOldEmoji(@NonNull MessageRecord messageRecord) {
-    return messageRecord.getReactions().stream()
-                        .filter(record -> record.getAuthor()
-                                                .serialize()
-                                                .equals(Recipient.self()
-                                                                 .getId()
-                                                                 .serialize()))
-                        .findFirst()
-                        .map(ReactionRecord::getEmoji)
