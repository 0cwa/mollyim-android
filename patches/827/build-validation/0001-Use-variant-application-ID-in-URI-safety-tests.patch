From cb08c452a7e6f0817dd433884823b767d3b7bfb9 Mon Sep 17 00:00:00 2001
From: Molly PoC Coordinator <poc@example.invalid>
Date: Sat, 24 Oct 2026 15:07:19 +0000
Subject: [PATCH] Use variant application ID in URI safety tests

---
 .../securesms/util/UriUtilTest_isValidExternalUri.java        | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/app/src/test/java/org/thoughtcrime/securesms/util/UriUtilTest_isValidExternalUri.java b/app/src/test/java/org/thoughtcrime/securesms/util/UriUtilTest_isValidExternalUri.java
index b437145304a..076f4f1de96 100644
--- a/app/src/test/java/org/thoughtcrime/securesms/util/UriUtilTest_isValidExternalUri.java
+++ b/app/src/test/java/org/thoughtcrime/securesms/util/UriUtilTest_isValidExternalUri.java
@@ -11,6 +11,7 @@ import android.net.Uri;
 
 import androidx.test.core.app.ApplicationProvider;
 
+import org.thoughtcrime.securesms.BuildConfig;
 import org.junit.Test;
 import org.junit.runner.RunWith;
 import org.robolectric.ParameterizedRobolectricTestRunner;
@@ -28,7 +29,7 @@ public class UriUtilTest_isValidExternalUri {
   private final String  input;
   private final boolean output;
 
-  private static final String APPLICATION_ID = "org.thoughtcrime.securesms";
+  private static final String APPLICATION_ID = BuildConfig.APPLICATION_ID;
 
   @ParameterizedRobolectricTestRunner.Parameters
   public static Collection<Object[]> data() {
@@ -62,6 +63,7 @@ public class UriUtilTest_isValidExternalUri {
     Context context = ApplicationProvider.getApplicationContext();
     Uri     uri     = Uri.parse(input);
 
+    assertEquals(APPLICATION_ID, context.getPackageName());
     assertEquals(output, UriUtil.isValidExternalUri(context, uri));
   }
 }
