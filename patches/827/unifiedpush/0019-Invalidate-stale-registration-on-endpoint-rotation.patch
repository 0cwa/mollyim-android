From: Molly PoC Coordinator <poc@example.invalid>
Date: Sat, 24 Oct 2026 15:41:06 +0000
Subject: [PATCH] Invalidate stale push registration during endpoint rotation

---
 .../receiver/UnifiedPushReceiver.kt           |  4 +
 .../UnifiedPushReceiverAvailabilityTest.kt    | 86 ++++++++++++++++++-
 2 files changed, 89 insertions(+), 1 deletion(-)

diff --git a/app/src/main/java/im/molly/unifiedpush/receiver/UnifiedPushReceiver.kt b/app/src/main/java/im/molly/unifiedpush/receiver/UnifiedPushReceiver.kt
index de863abaeef..d793504639a 100644
--- a/app/src/main/java/im/molly/unifiedpush/receiver/UnifiedPushReceiver.kt
+++ b/app/src/main/java/im/molly/unifiedpush/receiver/UnifiedPushReceiver.kt
@@ -140,6 +140,10 @@ class UnifiedPushReceiver : MessagingReceiver() {
   private fun refreshEndpoint(endpoint: String?): Boolean {
     val stored = SignalStore.unifiedpush.endpoint
     return if (endpoint != stored) {
+      if (endpoint != null && SignalStore.unifiedpush.registrationStatus == RegistrationStatus.REGISTERED) {
+        // Keep the old server registration unavailable until the updated endpoint is confirmed.
+        SignalStore.unifiedpush.registrationStatus = RegistrationStatus.PENDING
+      }
       SignalStore.unifiedpush.endpoint = endpoint
       AppDependencies.jobManager.add(UnifiedPushRefreshJob(testPing = false, fromNewEndpoint = true))
       true
