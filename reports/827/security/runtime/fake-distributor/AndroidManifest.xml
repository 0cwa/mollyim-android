<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.example.upfake">
    <application android:label="UP Local Test Distributor" android:allowBackup="false">
        <activity android:name=".BootstrapActivity" android:exported="true" />
        <receiver android:name=".DistributorReceiver" android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.distributor.REGISTER" />
                <action android:name="org.unifiedpush.android.distributor.UNREGISTER" />
                <action android:name="org.example.upfake.TEST_MESSAGE" />
                <action android:name="org.example.upfake.TEST_UNREGISTERED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
